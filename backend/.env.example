NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173
# true permite que el backend publique también frontend/dist.
SERVE_FRONTEND=false

# memory permite ejecutar el proyecto sin infraestructura. Usa mongo en producción.
PERSISTENCE_MODE=memory
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=galco_viaticos

# Debe ser false en producción.
AUTH_BYPASS=true
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# demo | openai | ocrspace | custom
OCR_PROVIDER=demo
OCR_TIMEOUT_MS=20000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OCRSPACE_API_KEY=
CUSTOM_OCR_ENDPOINT=
CUSTOM_OCR_TOKEN=
